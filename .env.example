# smartA.R.S.E. — environment template (no secrets)
# Copy to `.env.local` and fill in values. See README.md for setup notes.

# --- Public (embedded in browser bundle) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: override cookie policy URL on demo flow (default: /help/cookies)
# NEXT_PUBLIC_DEMO_COOKIE_POLICY_URL=

# --- Server-only (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=

# n8n chat proxy (POST /api/n8n) — server-only URL; do NOT use NEXT_PUBLIC_N8N_*
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# n8n async callback (POST /api/chat/n8n-complete) — rotate if compromised
CHAT_N8N_CALLBACK_SECRET=
# Alias: N8N_CHAT_CALLBACK_SECRET=

# Vercel Cron (Authorization: Bearer ...)
CRON_SECRET=

# Demo access (HMAC email approve/reject links — rotate periodically)
DEMO_APPROVAL_SECRET=
# DEMO_APPROVAL_TOKEN_TTL_HOURS=72
# DEMO_REQUEST_TTL_DAYS=7
# DEMO_NOTIFICATION_EMAIL=

# Email (Resend)
EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM_ADDRESS=
# EMAIL_RESEND_SANDBOX=true
